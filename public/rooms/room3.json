        ]
      }
    },
    {
      "id": "path3",
      "label": "Sandy Path",
      "nouns": ["path", "trail", "sand", "track"],
      "x": 120, "y": 152, "w": 168, "h": 26,
      "verbs": {
        "lookAt": [
          { "type": "say", "text": "A sandy trail, swept thin by the wind. It runs east into the cave." }
        ]
