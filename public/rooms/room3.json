              { "type": "wait", "ms": 800 },
              { "type": "goTo", "room": "room2", "spawnX": 55, "spawnY": 145 }
            ],
            "else": [
              { "type": "say", "text": "It's locked tight. I need a key." }
            ]
          }
        ],
        "pickUp": [
          { "type": "say", "text": "It's set into solid rock. It isn't going anywhere." }
        ]
      }
